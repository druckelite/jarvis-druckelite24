{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "web/dist",
    "rootDir": "web/src",
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": ["web/src/**/*.ts"],
  "exclude": ["node_modules", "web/dist"]
}
