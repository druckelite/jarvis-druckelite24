# .env.example
# Copy this to .env and fill in your real values.
# NEVER commit .env — it is in .gitignore.
# All variables are read exclusively in server/config.js.

# -- OpenAI ------------------------------------------------------------------
# Your OpenAI API key with Realtime API access enabled.
OPENAI_API_KEY=sk-...

# Current realtime speech-to-speech model (VERIFY at https://platform.openai.com/docs/models)
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# OpenAI native voice. Options: alloy, echo, shimmer, cedar, etc.
OPENAI_VOICE=alloy

# -- Shopify ------------------------------------------------------------------
# Your Shopify store domain — no protocol prefix, no trailing slash.
SHOPIFY_STORE_DOMAIN=druckelite24.myshopify.com

# Admin API token from a Custom App with scopes: read_orders, read_products, read_customers
SHOPIFY_ADMIN_TOKEN=shpat_...

# Shopify Admin GraphQL API version (VERIFY: must be a currently supported version)
SHOPIFY_API_VERSION=2025-07

# -- JARVIS behaviour ---------------------------------------------------------
# BCP-47 language tag — locks recognition and response language.
JARVIS_LANGUAGE=de-DE

# Wake word, lowercased. Matched loosely.
JARVIS_WAKE_WORD=hey jarvis

# Silence duration (ms) before JARVIS treats a pause as end-of-turn.
# Below ~500 ms JARVIS will cut off natural German pauses mid-sentence.
JARVIS_VAD_SILENCE_MS=600

# Cache TTL (ms) for Shopify data. Shared between panels and voice tools.
JARVIS_CACHE_TTL_MS=60000

# -- Runtime ------------------------------------------------------------------
# Render injects PORT automatically. Set to 10000 locally to match Render default.
PORT=10000

NODE_ENV=development

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
